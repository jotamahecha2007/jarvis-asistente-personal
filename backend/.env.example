# Puerto donde escucha el servidor (coincide con http://localhost:8080/api/ del diagrama)
PORT=8080

# Ollama corriendo en el mismo Mac mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Clave simple compartida entre la app movil y el servidor (viaja dentro de la red de Tailscale,
# pero igual conviene no dejarlo abierto). Genera algo largo y random para produccion.
JARVIS_API_KEY=cambia-esto-por-una-clave-larga

# --- Integraciones (opcional, se pueden ir llenando de a una) ---
# Correos (IMAP) - ej. Gmail con contraseña de aplicacion
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_USER=
MAIL_PASS=

# Google Drive (OAuth2 - client id/secret de Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# WhatsApp (via whatsapp-web.js u otra librería que corras aparte y le pegue a este server)
WHATSAPP_WEBHOOK_TOKEN=

# Github
GITHUB_TOKEN=
